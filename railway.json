{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksPlan": {
            "providers": ["java"],
            "buildCommand": "cd backend && ./mvnw clean package -DskipTests"
        }
    },
    "deploy": {
        "startCommand": "java -jar backend/target/backend-1.0-SNAPSHOT.jar"
    }
}